generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  COMPLETED
  MAINTENANCE
  CANCELLED
}

enum MaterialStatus {
  AWAITING
  RECEIVED
  NOT_NEEDED
}

enum ActivityKind {
  NOTE
  STATUS_CHANGED
  TASK_COMPLETED
  MATERIAL_RECEIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id              String  @id @default("default")
  senderName      String  @default("Staark Inc.")
  senderEmail     String
  signature       String?
  defaultTemplate String  @default("staark-standard")

  // Google Analytics
  ga4RefreshToken String?
  ga4ConnectedAt  DateTime?

  gmailRefreshToken   String?
  gmailHistoryId      String?
  gmailWatchExpiresAt DateTime?
  gmailConnectedAt    DateTime?

  updatedAt DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  messages Message[]
  threads  Thread[]
  clients  Client[]

  @@index([email])
  @@index([createdAt])
}

model Lead {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  service String?
  budget  String?
  message String?

  status   LeadStatus @default(NEW)
  clientId String?
  client   Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([status])
  @@index([createdAt])
}

model Client {
  id                 String  @id @default(cuid())
  name               String
  billingEmail       String?
  phone              String?
  organizationNumber String?
  billingAddress     String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]
  projects Project[]

  @@index([name])
  @@index([createdAt])
}

model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /* Optional link to the Inbox conversation with this client. */
  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  name        String
  description String?

  status ProjectStatus @default(PLANNING)

  budget  String?
  liveUrl String?

  startedAt DateTime?
  dueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      ProjectTask[]
  materials  ProjectMaterial[]
  activities ProjectActivity[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model ProjectMaterial {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name   String
  status MaterialStatus @default(AWAITING)

  position Int @default(0)

  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([projectId])
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind    ActivityKind @default(NOTE)
  title   String
  detail  String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title String
  done  Boolean @default(false)

  /* Manual ordering inside a project. */
  position Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId])
}

model Thread {
  id String @id @default(cuid())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  subject       String
  gmailThreadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  projects Project[]

  @@index([contactId])
  @@index([updatedAt])
}

model Message {
  id        String           @id @default(cuid())
  direction MessageDirection

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  fromName  String?
  fromEmail String
  toEmail   String

  subject String
  body    String

  isRead Boolean @default(false)

  gmailMessageId String? @unique
  rfcMessageId   String? @unique
  inReplyTo      String?
  references     String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([contactId])
  @@index([threadId])
  @@index([createdAt])
  @@index([direction])
  @@index([isRead])
  @@index([fromEmail])
  attachments MessageAttachment[]

  @@index([inReplyTo])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([messageId])
}