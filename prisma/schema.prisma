generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ContactChannel {
  EMAIL
  WHATSAPP
  FACEBOOK
}

enum ProspectStatus {
  NO_WEBSITE
  BROKEN_WEBSITE
  OLD_WEBSITE
  WEAK_WEBSITE
  GOOD_WEBSITE
  IGNORED
  IMPORTED
}

enum OfferStatus {
  DRAFT
  SHARED
  VIEWED
  ACCEPTED
  DECLINED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
}

enum SupportCoverage {
  UNASSESSED
  INCLUDED
  EXTRA
}

enum SupportCategory {
  WEBSITE
  HOSTING
  EMAIL
  BUG
  CHANGE
  OTHER
}

enum SupportPriority {
  NORMAL
  URGENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  COMPLETED
  MAINTENANCE
  CANCELLED
}

enum MaterialStatus {
  AWAITING
  RECEIVED
  NOT_NEEDED
}

enum ActivityKind {
  NOTE
  STATUS_CHANGED
  TASK_COMPLETED
  MATERIAL_RECEIVED
}

enum StaarkPlanCode {
  STARTER
  SAAS
  BUSINESS
}

enum BillingEnvironment {
  TEST
  LIVE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELING
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum SaasProvisioningStatus {
  PENDING_SETUP
  CLAIMED
  ACTIVE
  FAILED
}

model User {
  id                      String         @id @default(cuid())
  name                    String
  email                   String         @unique
  passwordHash            String
  role                    UserRole       @default(ADMIN)
  notificationPreferences Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  notifications           Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  href      String?
  metadata  Json?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

model Settings {
  id              String  @id @default("default")
  senderName      String  @default("Staark Inc.")
  senderEmail     String
  replyToEmail    String?
  signature       String?
  defaultTemplate String  @default("staark-standard")
  emailTemplates  Json?

  // Google Analytics
  ga4RefreshToken String?
  ga4ConnectedAt  DateTime?

  gmailRefreshToken   String?
  gmailHistoryId      String?
  gmailWatchExpiresAt DateTime?
  gmailConnectedAt    DateTime?

  updatedAt DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  facebook  String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  messages Message[]
  threads  Thread[]
  clients  Client[]

  @@index([email])
  @@index([phone])
  @@index([facebook])
  @@index([createdAt])
}

model Lead {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  service String?
  budget  String?
  message String?

  contactChannel ContactChannel @default(EMAIL)
  status         LeadStatus     @default(NEW)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  prospect Prospect?
  offers   Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([contactChannel])
  @@index([status])
  @@index([createdAt])
}

model Prospect {
  id      String @id @default(cuid())
  placeId String @unique

  name     String
  city     String?
  category String?
  address  String?

  website      String?
  email        String?
  websitePhone String?
  googlePhone  String?
  contactPage  String?
  contactForm  Boolean @default(false)

  facebook  String?
  instagram String?
  linkedin  String?

  rating  Float?
  reviews Int?

  status       ProspectStatus @default(NO_WEBSITE)
  leadScore    Int            @default(0)
  websiteScore Int?
  reasons      Json?

  https         Boolean?
  mobile        Boolean?
  copyrightYear Int?
  loadSeconds   Float?
  pageTitle     String?
  httpStatus    Int?

  googleMapsUrl String?
  source        String @default("google_places")
  scannedAt     DateTime?

  importedLeadId String? @unique
  importedLead   Lead?   @relation(fields: [importedLeadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([category])
  @@index([leadScore])
  @@index([createdAt])
}

model Client {
  id                 String  @id @default(cuid())
  name               String
  billingEmail       String?
  phone               String?
  organizationNumber String?
  billingAddress     String?
  notes              String?
  saasPlanCode       StaarkPlanCode?
  saasEntitlements   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts             Contact[]
  leads                Lead[]
  projects             Project[]
  offers               Offer[]
  supportRequests      SupportRequest[]
  wordpressSites       WordPressSite[]
  billingCustomers     BillingCustomer[]
  billingSubscriptions BillingSubscription[]
  saasProvisionings    SaasProvisioning[]

  @@index([name])
  @@index([saasPlanCode])
  @@index([createdAt])
}

model BillingCustomer {
  id               String             @id @default(cuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  environment      BillingEnvironment
  stripeCustomerId String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscriptions BillingSubscription[]

  @@unique([clientId, environment])
  @@index([clientId])
  @@index([environment])
}

model BillingSubscription {
  id                   String                    @id @default(cuid())
  clientId             String
  client               Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingCustomerId    String
  billingCustomer      BillingCustomer           @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  environment          BillingEnvironment
  stripeSubscriptionId String                    @unique
  stripePriceId        String
  stripeProductId      String?
  planCode             StaarkPlanCode
  interval             BillingInterval
  currency             String                    @default("sek")
  unitAmountOre        Int
  taxBehavior          String                    @default("exclusive")
  status               BillingSubscriptionStatus
  cancelAtPeriodEnd    Boolean                   @default(false)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  entitlements         Json
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  provisioning SaasProvisioning?

  @@index([clientId])
  @@index([billingCustomerId])
  @@index([environment])
  @@index([planCode])
  @@index([status])
  @@index([currentPeriodEnd])
}

model SaasProvisioning {
  id                    String                 @id @default(cuid())
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingSubscriptionId String                 @unique
  billingSubscription   BillingSubscription    @relation(fields: [billingSubscriptionId], references: [id], onDelete: Cascade)
  environment           BillingEnvironment
  planCode              StaarkPlanCode
  entitlements          Json
  status                SaasProvisioningStatus @default(PENDING_SETUP)

  nextOrganizationId    String?
  nextSubscriptionId    String?
  nextSiteId            String?                @unique
  nextSiteKey           String?                @unique
  nextHostname          String?                @unique
  nextSiteUrl           String?
  nextProvisionedAt     DateTime?
  nextSetupExpiresAt    DateTime?

  requestedAt           DateTime               @default(now())
  claimedAt             DateTime?
  activatedAt           DateTime?
  failedAt              DateTime?
  lastError             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  setupClaims SaasSetupClaim[]

  @@index([clientId])
  @@index([environment])
  @@index([planCode])
  @@index([status])
  @@index([requestedAt])
}

model SaasSetupClaim {
  id             String           @id @default(cuid())
  provisioningId String
  provisioning   SaasProvisioning @relation(fields: [provisioningId], references: [id], onDelete: Cascade)
  tokenHash      String           @unique
  hint           String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([provisioningId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
}


model SaasAnnouncement {
  id           String        @id @default(cuid())
  title        String
  summary      String
  body         String
  kind         String        @default("announcement")
  audiencePlan StaarkPlanCode?
  published    Boolean       @default(false)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([published, publishedAt])
  @@index([audiencePlan])
  @@index([createdAt])
}

model Offer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  project Project?

  title           String
  scope           String?
  terms           String?
  oneTimePriceOre Int?
  monthlyPriceOre Int?
  includedMonths  Int         @default(6)
  status          OfferStatus @default(DRAFT)
  shareToken      String?     @unique
  sharedAt        DateTime?
  viewedAt        DateTime?
  decidedAt       DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  name        String
  description String?

  status ProjectStatus @default(PLANNING)

  budget  String?
  liveUrl String?

  startedAt DateTime?
  dueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           ProjectTask[]
  materials       ProjectMaterial[]
  activities      ProjectActivity[]
  supportRequests SupportRequest[]
  wordpressSites  WordPressSite[]
  demo            DemoDeployment?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model ProjectMaterial {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name   String
  status MaterialStatus @default(AWAITING)

  position Int @default(0)

  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([projectId])
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind   ActivityKind @default(NOTE)
  title  String
  detail String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title String
  done  Boolean @default(false)
  position Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId])
}

model Thread {
  id String @id @default(cuid())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  subject       String
  gmailThreadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages        Message[]
  projects        Project[]
  supportRequests SupportRequest[]

  @@index([contactId])
  @@index([updatedAt])
}

model SupportRequest {
  id String @id @default(cuid())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  reference String? @unique

  requesterName    String?
  requesterEmail   String?
  requesterCompany String?
  requesterWebsite String?

  title         String
  description   String?
  internalNotes String?

  category SupportCategory @default(OTHER)
  priority SupportPriority @default(NORMAL)

  status           SupportStatus   @default(OPEN)
  coverage         SupportCoverage @default(UNASSESSED)
  timeSpentMinutes Int             @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  wordpressTicketSync WordPressTicketSync?

  @@index([clientId])
  @@index([projectId])
  @@index([threadId])
  @@index([requesterEmail])
  @@index([status])
  @@index([createdAt])
}

model Message {
  id        String           @id @default(cuid())
  direction MessageDirection

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  fromName  String?
  fromEmail String
  toEmail   String

  subject String
  body    String

  isRead Boolean @default(false)

  gmailMessageId String? @unique
  rfcMessageId   String? @unique
  inReplyTo      String?
  references     String?

  createdAt   DateTime            @default(now())
  sentAt      DateTime?
  attachments MessageAttachment[]

  @@index([contactId])
  @@index([threadId])
  @@index([createdAt])
  @@index([direction])
  @@index([isRead])
  @@index([fromEmail])
  @@index([inReplyTo])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([messageId])
}

model DemoDeployment {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  slug  String @unique
  image String
  port  Int    @default(3000)

  lastDeployedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WordPressSite {
  id                    String   @id @default(cuid())
  siteId                String   @unique
  siteSecretEncrypted   String
  siteUrl               String
  siteName              String
  adminUrl               String?
  wordpressVersion      String?
  phpVersion            String?
  hubVersion            String?
  theme                 String?
  locale                String?
  timezone              String?
  capabilities          Json?
  status                String   @default("CONNECTED")
  connectedAt           DateTime @default(now())
  lastSeenAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ticketSyncs WordPressTicketSync[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([lastSeenAt])
}

model WordPressPairingCode {
  id              String   @id @default(cuid())
  codeHash        String   @unique
  hint            String
  targetClientId  String?
  targetProjectId String?
  createdById     String
  expiresAt       DateTime
  usedAt          DateTime?
  usedBySiteId    String?
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([usedAt])
}

model WordPressTicketSync {
  id               String         @id @default(cuid())
  wordpressSiteId  String
  wordpressSite    WordPressSite  @relation(fields: [wordpressSiteId], references: [id], onDelete: Cascade)
  localId          Int
  supportRequestId String         @unique
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  payload          Json?
  createdAt        DateTime       @default(now())

  @@unique([wordpressSiteId, localId])
  @@index([wordpressSiteId])
  @@index([createdAt])
}