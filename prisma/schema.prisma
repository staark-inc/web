generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id        String           @id @default(cuid())
  direction MessageDirection

  fromName  String?
  fromEmail String
  toEmail   String

  subject   String
  body      String

  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())
  sentAt    DateTime?

  @@index([createdAt])
  @@index([direction])
  @@index([isRead])
  @@index([fromEmail])
}

model Settings {
  id              String   @id @default("default")
  senderName      String   @default("Staark Inc.")
  senderEmail     String
  signature       String?
  defaultTemplate String   @default("staark-standard")

  // Google Analytics
  ga4RefreshToken String?
  ga4ConnectedAt  DateTime?

  updatedAt       DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([email])
  @@index([createdAt])
}

model Lead {
  id        String     @id @default(cuid())
  contactId String
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  service   String?
  budget    String?
  message   String?

  status    LeadStatus @default(NEW)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([contactId])
  @@index([status])
  @@index([createdAt])
}